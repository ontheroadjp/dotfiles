              "output": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>小説『これが我が家の中学受験です』ドラフト</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n    <header>\n        <h1>小説『これが我が家の中学受験です』（仮）</h1>\n        <p>ドラフト一覧</p>\n    </header>\n    <main>\n        <nav>\n            <ul id=\"chapter-list\">\n                <!-- JavaScriptで動的に生成されます -->\n            </ul>\n        </nav>\n    </main>\n    <footer>\n        <p>&copy; 2025 Gemini</p>\n    </footer>\n    <script>\n        const chapterList = document.getElementById('chapter-list');\n        const totalChapters = 12; // GEMINI.mdに基づく総チャプター数\n\n        for (let i = 1; i <= totalChapters; i++) {\n            const chapterNum = i.toString().padStart(2, '0');\n            const listItem = document.createElement('li');\n            const link = document.createElement('a');\n            link.href = `chapter.html?c=${chapterNum}`;\n            link.textContent = `第${i}話`;\n            \n            // ファイルの存在確認は行わず、リンクを生成します。\n            // 存在しないファイルへのリンクはクリックしても何も表示されません。\n            listItem.appendChild(link);\n            chapterList.appendChild(listItem);\n        }\n    </script>\n</body>\n</html>\n"
