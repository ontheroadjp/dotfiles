# macos
.DS_Store
.TrashBox.log

github-tool-kit
home/git/.gitconfig_included
.config/shell-tools/

#
bin/*
!bin/.gitkeep
!bin/health-check.sh

# Exclude Gemini CLI specific files
home/.gemini/oauth_creds.json
home/.gemini/tmp/
home/.gemini/__pycache__/
home/.gemini/history/
.config/configstore/update-notifier-@google/gemini-cli.json

# vim plugins
home/vim/.vim/plugged/
home/vim/.vim/viminfo

# compiled files
*.zwc

# Exclude log files
*.log
*.log.*

# Exclude tags files
tags

# Exclude backup files and directories
bk_*
bk_*/
mac_osx/karabiner_elements/automatic_backups/
mac_osx/HandBrakeCLI*


# Exclude environment files and virtual environments
tools/deepl-translate-en/.env
tools/deepl-translate-en/venv/
bin/deepl-translate-en

# Exclude credentials files (XDG config secrets)
home/.config/shell-tools/**/credentials
home/.config/**/.env

# Exclude Vagrant
home/vagrant/
home/vagrant/.vagrant.d
