# fd.zs

alias fda='fd -HI'
alias fdh='fd -H'
alias fdf='fd -t f'
alias fdd='fd -t d'

alias fdsstore="fd -HI -t f '^.DS_Store$'"
alias fmd='fd . -e md'
alias fjpg='fd . -e jpg -e jpag'
alias fgif='fd . -e gif'
alias fmp3='fd . -e mp3'
alias fmp4='fd . -e mp4'

alias fmdc='fd . -e md | wc -l'
alias fjpgc='fd . -e jpg -e jpag | wc -l'
alias fgifc='fd . -e gif | wc -l'
alias fmp3c='fd . -e mp3 | wc -l'
alias fmp4c='fd . -e mp4 | wc -l'

